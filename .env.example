# Postgres (e.g. Neon). Pooled URL for the app, direct URL for schema changes.
DATABASE_URL="postgresql://user:password@host-pooler/db?sslmode=require"
DIRECT_URL="postgresql://user:password@host/db?sslmode=require"

# Long random string used to sign login sessions
AUTH_SECRET="change-me-to-a-long-random-string"

# Optional: protects /api/cron/close-rounds (call it every few minutes to auto-close rounds)
CRON_SECRET="change-me"

# Twilio — leave blank to run in simulation mode (messages are logged, not sent)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_SMS_FROM=""            # e.g. +15551234567
TWILIO_WHATSAPP_FROM=""       # e.g. +14155238886 (Twilio sandbox number)

# First admin created by `npm run db:seed`
SEED_ADMIN_EMAIL="admin@nasco.com"
SEED_ADMIN_PASSWORD="admin1234"

# Arkesel SMS (Ghana) — used for SMS when set. Get a key at sms.arkesel.com → SMS API
ARKESEL_API_KEY=""
ARKESEL_SENDER_ID="Nasco Lunch"   # max 11 characters, must be approved by Arkesel

# Public address of the app (used in shared menu links), e.g. https://lunch.nasco.com
APP_URL=""
